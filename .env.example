# ==============================================================================
# AUTISTIC JOURNEY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database connection (PostgreSQL - Supabase / Neon / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autistic_journey?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/autistic_journey?schema=public"

# Authentication & Session Security
AUTH_SECRET="replace-with-a-random-64-character-secret-key-for-session-signing"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Object Storage Configuration (AWS S3 or Cloudflare R2)
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET_NAME="autistic-journey-archive"
STORAGE_ACCESS_KEY_ID="your-r2-or-s3-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-r2-or-s3-secret-access-key"
STORAGE_PUBLIC_URL="https://cdn.yourdomain.com"

# Ingestion Constraints & Limits
NEXT_PUBLIC_MAX_PHOTO_SIZE_MB="50"
NEXT_PUBLIC_MAX_VIDEO_SIZE_MB="2048"
PRESIGNED_EXPIRATION_SECONDS="900"
